#!/usr/bin/env bash
# Starts the Vite dev server. Runs for the whole session; killed on project close.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Load PORT (and FIGMA_MAKE_URL) from the env file next to this script.
set -a
. "$(dirname "$0")/env"
set +a

# Bind Vite to the shared PORT and expose it on all interfaces for the preview.
exec npx vite --port "$PORT" --strictPort --host
